# Database (SQLite — path relative to prisma/schema.prisma → prisma/data/ayurvaflow.db)
DATABASE_URL="file:./data/ayurvaflow.db"

# Auth — REQUIRED in production (32+ random characters)
# Generate: openssl rand -base64 48
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# Set to 1 when behind nginx/Caddy/load balancer
TRUST_PROXY=0

# Frontend (optional — defaults to /api when served from same host)
VITE_API_URL=""

{
  // Server-side TypeScript config — covers Express API, Prisma seed, and utility scripts.
  // Uses CommonJS-compatible module settings (Node 18+ ESM via tsx at runtime).
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",

    /* Language & environment */
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Node16",

    /* Module resolution — bundler not valid for server, use node16 */
    "moduleResolution": "Node16",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,

    /* Path aliases — kept in sync with client @/* for shared types */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Type sources */
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true,

    /* Strict type checking */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* TS 6.x compat */
    "erasableSyntaxOnly": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["server", "prisma", "scripts"]
}

# AyurvaFlow / Kairali CMS — reverse proxy example
# Place behind HTTPS (certbot / Caddy). App listens on 127.0.0.1:3001

upstream ayurvaflow {
  server 127.0.0.1:3001;
  keepalive 32;
}

server {
  listen 443 ssl http2;
  server_name clinic.example.com;

  # ssl_certificate /etc/letsencrypt/live/clinic.example.com/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/clinic.example.com/privkey.pem;

  client_max_body_size 16m;

  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  location / {
    proxy_pass http://ayurvaflow;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
  }
}

server {
  listen 80;
  server_name clinic.example.com;
  return 301 https://$host$request_uri;
}
